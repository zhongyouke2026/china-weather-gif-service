# Shared by Next.js and the batch job. Never expose these as NEXT_PUBLIC_*.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
WEATHER_STORAGE_BUCKET=weather-assets
WEATHER_ASSET_KEY=china-7d

# QWeather Console > Settings > API Host / Credentials.
# Use the dedicated *.qweatherapi.com host, without a path.
QWEATHER_API_HOST=https://YOUR_HOST.qweatherapi.com
QWEATHER_API_KEY=YOUR_QWEATHER_API_KEY
QWEATHER_LANGUAGE=ko
# QWEATHER_API_MODE=auto  # auto, modern, or legacy

# Protects the Vercel Cron endpoint. Use at least 16 random characters.
CRON_SECRET=replace-with-a-long-random-secret

# Optional: Vercel Cron can dispatch the heavy job to GitHub Actions.
GITHUB_ACTIONS_REPOSITORY=owner/repository
GITHUB_ACTIONS_TOKEN=github-fine-grained-token

# Optional pipeline tuning.
NOAA_GFS_BASE_URL=https://nomads.ncep.noaa.gov
WEATHER_WORK_DIR=work
WEATHER_OUTPUT_DIR=artifacts
WEATHER_MAX_FORECAST_HOUR=168
WEATHER_FRAME_STEP_HOURS=3
WEATHER_DOWNLOAD_WORKERS=3
WEATHER_FRAME_DURATION_MS=420
WEATHER_GIF_COLORS=192
WEATHER_LOG_LEVEL=INFO
